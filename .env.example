# ── 数据库 ───────────────────────────────────────────────────────────────
# 本机开发（连本地 Homebrew Postgres）
DATABASE_URL=postgresql+asyncpg://fitness:fitness@localhost:5432/fitness
# docker compose 环境下由 compose 覆盖为 @postgres:5432
# worker 跨用户领取 jobs，生产环境必须使用具备 BYPASSRLS 的独立数据库角色。
# 本地 Docker 的 POSTGRES_USER 是数据库超级用户，可复用 DATABASE_URL。
WORKER_DATABASE_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── 认证 ─────────────────────────────────────────────────────────────────
# 至少 32 字符。生成：openssl rand -hex 32
JWT_SECRET=请替换为至少32字符的随机字符串________________

# ── 模型服务（填你自己的）────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 主模型不可用时切到这个（可留空，留空则跳过 L2 降级）
LLM_FALLBACK_MODEL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ── Agent 行为 ───────────────────────────────────────────────────────────
AGENT_MAX_TURNS=6
AGENT_TOOL_TIMEOUT_S=3.0
AGENT_HISTORY_WINDOW=6
