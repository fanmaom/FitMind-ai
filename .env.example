# ── 对外访问地址与端口 ───────────────────────────────────────────────────
# 这三个端口是宿主机端口；容器内部端口固定，不需要修改。
# 若本机端口已被占用，请改成未占用的 1024–65535 端口，例如 WEB_PORT=3100。
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5433
# 浏览器访问 API 的地址。修改 WEB_PORT / API_PORT 或部署到另一台机器时，
# 也要相应修改此项和下方 CORS_ORIGINS。末尾必须保留 /api/v1。
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# ── 数据库 ───────────────────────────────────────────────────────────────
# 本机开发（连本地 Homebrew Postgres）
DATABASE_URL=postgresql+asyncpg://fitness:fitness@localhost:5432/fitness
# docker compose 环境下由 compose 覆盖为 @postgres:5432
# worker 跨用户领取 jobs，生产环境必须使用具备 BYPASSRLS 的独立数据库角色。
# Docker 会自动创建受 RLS 约束的 fitness_app 与专用 fitness_worker。
WORKER_DATABASE_URL=
# 允许访问 API 的前端地址，多个地址用英文逗号分隔。
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── 认证 ─────────────────────────────────────────────────────────────────
# 至少 32 字符。生成：openssl rand -hex 32
JWT_SECRET=请替换为至少32字符的随机字符串________________

# ── 模型服务（填你自己的）────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 主模型不可用时切到不同厂商/架构的模型，避免同源故障；留空则跳过 L2。
# 示例：主模型用 hy3 时，可填写网关中已验证可用的另一厂商模型名。
LLM_FALLBACK_MODEL=
# 单次调用的输出上限。**推理模型的思考 token 也算在这里面**，给小了不是截断，
# 而是正文整段为空（HTTP 200 + finish_reason=length，没有任何报错）。
# 实测 hy3 在工具结果回灌那一轮：2048 全被思考吃光、正文 0 字；8192 正常。
# 这是上限不是用量，调大不多花钱；换成非推理模型可以调小。
LLM_MAX_TOKENS=8192
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ── Agent 行为 ───────────────────────────────────────────────────────────
AGENT_MAX_TURNS=6
AGENT_TOOL_TIMEOUT_S=3.0
AGENT_HISTORY_WINDOW=6

# ── MCP 外部工具（可选，默认关闭）────────────────────────────────────────
# 挂载外部 MCP server，让助理用上本仓库没写的能力。格式与 Claude Desktop /
# Cursor 的 mcpServers 一致，可以直接把现成配置贴过来（注意压成一行）。
#
# 镜像里预装了 uv，所以 uvx 系的 server 开箱可用；npx 系需要自己在
# backend/Dockerfile 里补装 Node。
#
# readonly 要显式声明：MCP 协议不表达副作用，默认按写操作对待——降级层据此
# 决定能否安全重试，误判成只读会导致重复写入。
#
# MCP_SERVERS={"mcpServers":{"time":{"command":"uvx","args":["mcp-server-time"],"readonly":true}}}
MCP_SERVERS=
# 外部工具的调用超时。比本地工具（3s）宽松：MCP server 在另一个进程、
# 往往还要走网络。
MCP_TOOL_TIMEOUT_S=15.0

# ── 反向：把这个助理挂给 Claude Desktop / Cursor ──────────────────────────
# 下面这两个变量不写在这里，而是写进 MCP 客户端配置的 env 段——它们属于
# "以某个用户身份运行"的凭据，不是服务端配置。
#
#   FITMIND_TOKEN            登录后拿到的 access token，决定以谁的身份查数据
#   FITMIND_MCP_ALLOW_WRITE  设为 1 才允许写操作。默认只读：token 明文躺在
#                            客户端配置文件里，泄漏后果是"数据被改"还是
#                            "数据被读"，差别很大
#
# 完整配置示例见 README 的「反向：把这个助理挂给别的 MCP 客户端」。
